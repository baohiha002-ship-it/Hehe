end)

-- 2. Nút Chạy tự động trên máy chạy bộ (Treadmill)
createButton("Tự động chạy trên Máy chạy bộ (Anti-AFK Training)", function()
    _G_Config.Treadmill = not _G_Config.Treadmill
    task.spawn(function()
        while _G_Config.Treadmill do
            task.wait(0.5)
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                -- Giả lập di chuyển nhẹ trên máy chạy bộ
                char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(0, 0, 0.1)
            end
        end
    end)
end)

-- Tạo bảng xếp hạng (Leaderboard Modal UI)
local function createRankingModal(titleText, isCrossServer)
    if game.CoreGui:FindFirstChild("ToroRankingModal") then
        game.CoreGui.ToroRankingModal:Destroy()
    end
    
    local modal = Instance.new("Frame")
    modal.Name = "ToroRankingModal"
    modal.Parent = ScreenGui
    modal.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    modal.Position = UDim2.new(0.5, -200, 0.5, -175)
    modal.Size = UDim2.new(0, 400, 0, 350)
    modal.Active = true
    modal.Draggable = true
    
    local mCorner = Instance.new("UICorner")
    mCorner.CornerRadius = UDim.new(0, 10)
    mCorner.Parent = modal
    
    local mTitle = Instance.new("TextLabel")
    mTitle.Parent = modal
    mTitle.Size = UDim2.new(1, -40, 0, 40)
    mTitle.BackgroundTransparency = 1
    mTitle.Font = Enum.Font.GothamBold
    mTitle.Text = titleText
    mTitle.TextColor3 = Color3.fromRGB(255, 215, 0)
    mTitle.TextSize = 14
    mTitle.TextXAlignment = Enum.TextXAlignment.Left
    mTitle.Position = UDim2.new(0, 15, 0, 0)
    
    local closeBtn = Instance.new("TextButton")
    closeBtn.Parent = modal
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -35, 0, 5)
    closeBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.MouseButton1Click:Connect(function()
        modal:Destroy()
    end)
    
    local scroller = Instance.new("ScrollingFrame")
    scroller.Parent = modal
    scroller.BackgroundTransparency = 1
    scroller.Position = UDim2.new(0, 10, 0, 50)
    scroller.Size = UDim2.new(1, -20, 1, -60)
    scroller.CanvasSize = UDim2.new(0, 0, 2, 0)
    scroller.ScrollBarThickness = 4
    
    local sLayout = Instance.new("UIListLayout")
    sLayout.Parent = scroller
    sLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sLayout.Padding = UDim.new(0, 5)
    
    -- Dữ liệu giả lập mẫu hiển thị xếp hạng Giá trị / s (Money/s)
    local sampleData = {
        {name = "Golden Egg (Tier S)", value = "1,500,000 $/s", serverId = "server_1"},
        {name = "Diamond Egg (Tier A)", value = "850,000 $/s", serverId = "server_2"},
        {name = "Ruby Egg (Tier B)", value = "420,000 $/s", serverId = "server_3"},
        {name = "Normal Egg (Tier C)", value = "100,000 $/s", serverId = "server_4"}
    }
    
    for i, data in ipairs(sampleData) do
        local itemFrame = Instance.new("Frame")
        itemFrame.Parent = scroller
        itemFrame.Size = UDim2.new(1, 0, 0, 45)
        itemFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
        
        local iCorner = Instance.new("UICorner")
        iCorner.CornerRadius = UDim.new(0, 6)
        iCorner.Parent = itemFrame
        
        local infoLabel = Instance.new("TextLabel")
        infoLabel.Parent = itemFrame
        infoLabel.Size = UDim2.new(0.6, 0, 1, 0)
        infoLabel.Position = UDim2.new(0, 10, 0, 0)
        infoLabel.BackgroundTransparency = 1
        infoLabel.Font = Enum.Font.Gotham
        infoLabel.Text = i..". "..data.name.."\nRate: "..data.value
        infoLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
        infoLabel.TextSize = 12
        infoLabel.TextXAlignment = Enum.TextXAlignment.Left
        
        local actionBtn = Instance.new("TextButton")
        actionBtn.Parent = itemFrame
        actionBtn.Size = UDim2.new(0.35, 0, 0, 30)
        actionBtn.Position = UDim2.new(0.62, 0, 0.15, 0)
        actionBtn.BackgroundColor3 = Color3.fromRGB(75, 0, 130)
        actionBtn.Font = Enum.Font.GothamBold
        actionBtn.Text = isCrossServer and "Join Server" or "Đi tới Trứng"
        actionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        actionBtn.TextSize = 11
        
        local bCorner = Instance.new("UICorner")
        bCorner.CornerRadius = UDim.new(0, 4)
        bCorner.Parent = actionBtn
        
        actionBtn.MouseButton1Click:Connect(function()
            if isCrossServer then
                print("Đang thực hiện chuyển sang Server tối ưu có trứng cao nhất...")
                -- TeleportService:TeleportToPlaceInstance(game.PlaceId, data.serverId, LocalPlayer)
            else
                print("Đang định vị và di chuyển đến vị trí quả trứng...")
            end
        end)
    end
end

