-- Hàm Anti-AFK
local function setupAntiAFK()
    LocalPlayer.Idled:Connect(function()
        if _G_Config.AntiAFK then
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end
    end)
end
task.spawn(setupAntiAFK)

-- Hàm Anti-Ban giả lập thao tác tự nhiên
task.spawn(function()
    while task.wait(30) do
        if _G_Config.AntiBan then
            -- Thực hiện chuyển động vi mô ngẫu nhiên tránh bị phát hiện bot
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                character.HumanoidRootPart.CFrame = character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(math.random(-5, 5)), 0)
            end
        end
    end
end)

